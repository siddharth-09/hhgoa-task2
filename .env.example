# Hugging Face token — https://huggingface.co/settings/tokens ("Read" scope is enough).
# Optional, but it lifts the anonymous rate limit and speeds up downloads, which
# matters when streaming parquet shards and pulling the ONNX model.
HF_TOKEN=

# Speech-to-text (Sarvam). Get from https://dashboard.sarvam.ai
SARVAM_API_KEY=

# Answer generation. Set LLM_PROVIDER to whichever key you have.
#   gemini    -> https://aistudio.google.com/apikey  (free tier)
#   anthropic -> https://console.anthropic.com
#   openrouter-> https://openrouter.ai/keys  (one key, ~500 models)
#   bedrock   -> uses your AWS IAM credentials, no separate key
LLM_PROVIDER=bedrock
BEDROCK_MODEL=global.anthropic.claude-haiku-4-5-20251001-v1:0
BEDROCK_REGION=ap-south-1
#   nvidia    -> https://build.nvidia.com  (NIM, OpenAI-compatible)
NVIDIA_API_KEY=
NVIDIA_MODEL=meta/llama-3.3-70b-instruct
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.0-flash-001
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
LLM_TIMEOUT_S=30

# Runtime
PORT=7860
INDEX_PATH=data/index

# AWS (ap-south-1 / Mumbai - closest region to the judges)
AWS_PROFILE=hhgoa
AWS_DEFAULT_REGION=ap-south-1
INDEX_S3_URI=s3://hhgoa-task2-index-573594947163/index
LOG_LEVEL=INFO

# Retrieval tuning
RETRIEVE_TOP_K=50
RERANK_TOP_K=8
MIN_GROUNDING_SCORE=0.35
